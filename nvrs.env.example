# The NVRs every project uses -- copy to nvrs.env and fill in (nvrs.env holds passwords: never commit it).
# One block per NVR: NVR_<NAME>_<KEY>=...
# The name HOME_HIK is written home-hik:<camera no> in --camera (the number shown on the NVR's screen, from 1).

NVR_HOME_HIK_VENDOR=hik
NVR_HOME_HIK_IP=192.168.x.x
NVR_HOME_HIK_USER=admin
NVR_HOME_HIK_PASSWORD=
# NVR_HOME_HIK_PORT=8000
# NVR_HOME_HIK_RTSP_PORT=554
# Cap on concurrent downloads from this NVR (--connections never goes above it); unset = no cap
# NVR_HOME_HIK_MAX_CONNECTIONS=4

NVR_SHOP_DAHUA_VENDOR=dahua
NVR_SHOP_DAHUA_IP=192.168.x.x
NVR_SHOP_DAHUA_USER=admin
NVR_SHOP_DAHUA_PASSWORD=
# NVR_SHOP_DAHUA_PORT=37777
# NVR_SHOP_DAHUA_RTSP_PORT=554
